      "get": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "getRefreshToken",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string",
              "default": "abc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResLoginDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/account": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "getAccount",
        "responses": {
          "200": {
